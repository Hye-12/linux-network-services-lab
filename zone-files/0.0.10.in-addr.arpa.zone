$TTL 1D
@	IN SOA	ns1.hye12.local. web. (
					0	; serial
					1D	; refresh
					1H	; retry
					1W	; expire
					3H )	; minimum

; Name Server
	NS	ns1.hye12.local.
	NS	ns2.hye12.local.
	NS	ns3.hye12.local.

; PTR Record
11	IN 	PTR	ns2.hye12.local.
12	IN 	PTR	ns1.hye12.local.
13	IN 	PTR	ns3.hye12.local.
